# Identifiants API Quran Foundation (https://api-docs.quran.foundation)
# Crée un compte développeur, puis une application, pour obtenir ces valeurs.
# Nécessaires pour le bouton "Importer depuis Quran.com" de l'éditeur.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# "prelive" (défaut) ou "production". Les nouveaux comptes reçoivent des
# identifiants pré-production ; l'accès production se demande séparément.
# Ne passe à "production" qu'une fois cet accès accordé.
QURAN_API_ENV=prelive
